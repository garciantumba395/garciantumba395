{
  "name": "solisend-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Application de bureau (coquille Electron) pour Solisend",
  "main": "main.js",
  "author": "Solisend",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.example.solisend",
    "productName": "Solisend",
    "files": ["main.js", "app-config.json", "preload.js"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
