APP_NAME=Solisend
APP_TIMEZONE=Africa/Kinshasa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sms_saas
DB_USERNAME=sms
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=Solisend

# --- SMS ---
# Par défaut : fournisseur fictif, AUCUN SMS réel. Ne jamais mettre de clé d'API dans le dépôt.
SMS_PROVIDER=fake
# Fournisseur retenu (D1) : infobip. Ne renseigner les clés que dans le .env du serveur.
# INFOBIP_BASE_URL=
# INFOBIP_API_KEY=
# INFOBIP_DEFAULT_SENDER=
# Un fournisseur réel ne fonctionne que si ceci est explicitement à true ET si SMS_PROVIDER le désigne.
SMS_SENDING_ENABLED=false

# --- Consentement (choix techniques, règles légales à valider : voir docs/DECISIONS.md D4) ---
CONSENT_REQUIRE_EVIDENCE=true
# CONSENT_MAX_AGE_DAYS=

# --- Étape 10 préparatoire : webhooks / SMS entrants / réconciliation (valeurs à valider : docs/DECISIONS.md D50-D53) ---
# Secret du fournisseur FICTIF pour tester les webhooks en local. Vide = tout webhook refusé. NE JAMAIS committer de vrai secret.
SMS_WEBHOOK_FAKE_SECRET=
SMS_WEBHOOK_TOLERANCE_SECONDS=300
SMS_WEBHOOK_MAX_BODY_BYTES=65536
SMS_WEBHOOK_RATE_LIMIT_PER_MINUTE=600
# Mots-clés de désinscription, séparés par des virgules.
SMS_INBOUND_OPTOUT_KEYWORDS=STOP
SMS_INBOUND_WINDOW_DAYS=30
SMS_RECONCILE_STALE_MINUTES=60
# --- Sécurité et exploitation (étape 9, valeurs par défaut dans config/security.php ; voir docs/OPERATIONS.md) ---
# SECURITY_HSTS=true
# SECURITY_HSTS_MAX_AGE=15552000
# SECURITY_CSP_REPORT_ONLY=false
# SESSION_SECURE_COOKIE=true   # OBLIGATOIRE derrière HTTPS (vérifié par php artisan security:check)
# SENDING_REVIEW_WINDOW_DAYS=7
# SENDING_REVIEW_MIN_SAMPLE=50

# --- D10 (tranchée : oui) : e-mail vérifié et 2FA obligatoires pour les administrateurs ---
# Pour le développement local ou la démonstration uniquement, vous pouvez passer l'un ou l'autre à false.
SECURITY_REQUIRE_EMAIL_VERIFICATION=true
SECURITY_REQUIRE_2FA_FOR_ADMINS=true
